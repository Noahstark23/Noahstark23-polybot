# ==========================================================
# POLYBOT — .env.example
# NUNCA commitear el .env real. NUNCA poner la private key aquí en claro.
# ==========================================================

# --- Entorno / venue ---
POLYMARKET_ENV=paper                 # paper | production  (arranca SIEMPRE en paper)
POLYGON_CHAIN_ID=137
CLOB_API_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com

# --- Auth EVM (Polygon) ---
# La private key se monta como SECRET VOLUME, aquí solo va la RUTA y la dirección pública.
POLY_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
POLY_SIGNER_KEY_PATH=/app/secrets/poly_wallet_key.json   # keystore cifrado (secret volume)
# Credenciales L2 del CLOB (se DERIVAN de la firma; también montadas como secrets)
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=
USDC_CONTRACT=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174   # USDC.e en Polygon

# --- Storage ---
DATABASE_URL=sqlite:////app/data/polybot.db               # local dev: sqlite:///./data/polybot.db

# --- Health server (dentro del contenedor; el host lo mapea a :18081) ---
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
LOG_LEVEL=INFO

# --- Interruptor maestro de trading (arranca APAGADO) ---
TRADING_ENABLED=false

# --- Motores ---
MOTOR_1_ARBITRAGE_ENABLED=true       # en Fase 2 corre en SHADOW aunque esté "true"

# --- Reglas de riesgo (heredadas del bot Kalshi, NO diluir) ---
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=8.0
MAX_MONTHLY_LOSS_PCT=15.0
MAX_SIMULTANEOUS_EXPOSURE_PCT=25.0
MAX_TRADE_SIZE_PCT=5.0
KELLY_FRACTION=0.25
MIN_EDGE_PCT=1.0                     # edge mínimo para considerar una oportunidad
MIN_EDGE_PCT_MAX=10.0               # filtro anti-fantasma: edge > esto => NO ejecuta
MIN_LIQUIDITY_CONTRACTS=10

# --- Capital ---
ACTIVE_CAPITAL_USD=100.0            # mínimo para Fase 3; en shadow es solo referencia
DYNAMIC_CAPITAL_ENABLED=true
CAPITAL_SAFETY_FACTOR_PCT=90.0
CAPITAL_FLOOR_USD=50.0
CAPITAL_CAP_USD=1000.0
CAPITAL_SMOOTHING_PCT=20.0
BALANCE_REFRESH_SECONDS=60

# --- Alertas (reutiliza tu bot de Telegram; usa un CHAT_ID distinto para no mezclar) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DASHBOARD_ENABLED=true
TELEGRAM_DASHBOARD_INTERVAL_SEC=3600

# --- Observabilidad ---
SENTRY_DSN=
